{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tessera.wm/schemas/v1/envelope.json",
  "title": "TesseraProtocolEnvelope",
  "type": "object",
  "required": ["protocol", "version", "id", "type"],
  "properties": {
    "protocol": {
      "type": "string",
      "const": "tessera.ipc"
    },
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": ["request", "response", "event"]
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": { "const": "request" },
        "method": { "type": "string", "minLength": 1 },
        "params": { "type": "object" }
      },
      "required": ["method"]
    },
    {
      "properties": {
        "type": { "const": "response" },
        "replyTo": { "type": "string", "minLength": 1 },
        "ok": { "type": "boolean" },
        "result": {},
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message": { "type": "string" },
            "details": {}
          }
        }
      },
      "required": ["replyTo", "ok"]
    },
    {
      "properties": {
        "type": { "const": "event" },
        "event": { "type": "string", "minLength": 1 },
        "data": {}
      },
      "required": ["event"]
    }
  ]
}
