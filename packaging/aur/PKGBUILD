# Maintainer: Drew (@Andrew-Smith-93)
pkgname=kwin-script-movement-git
_pkgname=movement
pkgver=1.0.3.r0
pkgrel=1
pkgdesc="Movement: dynamic tiling window manager for KDE Plasma 6"
arch=('any')
url="https://github.com/Andrew-Smith-93/Tessera"
license=('GPL-3.0-or-later')
depends=('kwin' 'plasma-workspace')
makedepends=('git')
provides=('kwin-script-movement' 'kwin-script-tessera' 'kwin-script-tessera-git')
conflicts=('kwin-script-movement' 'kwin-script-tessera' 'kwin-script-tessera-git')
source=("$_pkgname::git+https://github.com/Andrew-Smith-93/Tessera.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$_pkgname"
    printf "1.0.3.r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
    cd "$srcdir/$_pkgname"

    # Install KWin Script
    install -d "$pkgdir/usr/share/kwin/scripts/tessera"
    cp -r contents "$pkgdir/usr/share/kwin/scripts/tessera/"
    install -Dm644 metadata.json "$pkgdir/usr/share/kwin/scripts/tessera/metadata.json"

    # Install License
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
