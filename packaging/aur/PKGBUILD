# Maintainer: Drew (@Andrew-Smith-93)
pkgname=kwin-script-tessera-git
_pkgname=tessera
pkgver=1.0.1.r0
pkgrel=1
pkgdesc="Modern dynamic tiling window manager for KDE Plasma 6"
arch=('any')
url="https://github.com/Andrew-Smith-93/tiling-window-manager"
license=('GPL-3.0-or-later')
depends=('kwin' 'plasma-workspace')
makedepends=('git')
provides=('kwin-script-tessera')
conflicts=('kwin-script-tessera')
source=("$_pkgname::git+https://github.com/Andrew-Smith-93/tiling-window-manager.git")
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/$_pkgname"
    printf "1.0.1.r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
    cd "$srcdir/$_pkgname"

    # Install KWin Script
    install -d "$pkgdir/usr/share/kwin/scripts/tessera"
    cp -r contents "$pkgdir/usr/share/kwin/scripts/tessera/"
    install -Dm644 metadata.json "$pkgdir/usr/share/kwin/scripts/tessera/metadata.json"

    # Install License
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
