{
  "schemaVersion": "1.0.0",
  "name": "09-generic-wine-config-tiled",
  "description": "Generic non-fullscreen Wine desktop app tiles under default policy",
  "initialConfig": {
    "enableTiling": true,
    "defaultLayout": "master-stack"
  },
  "initialScreens": [
    {
      "outputId": "HDMI-A-1",
      "name": "HDMI-A-1",
      "geometry": {
        "x": 0,
        "y": 0,
        "width": 1920,
        "height": 1080
      },
      "usableArea": {
        "x": 0,
        "y": 0,
        "width": 1920,
        "height": 1080
      }
    }
  ],
  "events": [
    {
      "type": "window-discovered",
      "window": {
        "id": "wine-cfg",
        "resourceClass": "winecfg.exe",
        "resourceName": "kitty",
        "title": "Wine Configuration",
        "outputId": "HDMI-A-1",
        "frameGeometry": {
          "x": 100,
          "y": 100,
          "width": 600,
          "height": 400
        }
      }
    },
    {
      "type": "window-discovered",
      "window": {
        "id": "term-1",
        "resourceClass": "kitty",
        "resourceName": "kitty",
        "title": "Window term-1",
        "outputId": "HDMI-A-1",
        "frameGeometry": {
          "x": 100,
          "y": 100,
          "width": 600,
          "height": 400
        }
      }
    },
    {
      "type": "flush"
    }
  ]
}
