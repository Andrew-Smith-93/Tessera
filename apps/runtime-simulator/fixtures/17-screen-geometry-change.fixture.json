{
  "schemaVersion": "1.0.0",
  "name": "17-screen-geometry-change",
  "description": "Screen resolution change dirties screen and triggers retile to new dimensions",
  "initialConfig": {
    "enableTiling": true,
    "defaultLayout": "master-stack"
  },
  "initialScreens": [
    {
      "outputId": "HDMI-A-1",
      "name": "HDMI-A-1",
      "geometry": {
        "x": 0,
        "y": 0,
        "width": 1920,
        "height": 1080
      },
      "usableArea": {
        "x": 0,
        "y": 0,
        "width": 1920,
        "height": 1080
      }
    }
  ],
  "events": [
    {
      "type": "window-discovered",
      "window": {
        "id": "win-1",
        "resourceClass": "kitty",
        "resourceName": "kitty",
        "title": "Window win-1",
        "outputId": "HDMI-A-1",
        "frameGeometry": {
          "x": 100,
          "y": 100,
          "width": 600,
          "height": 400
        }
      }
    },
    {
      "type": "window-discovered",
      "window": {
        "id": "win-2",
        "resourceClass": "kitty",
        "resourceName": "kitty",
        "title": "Window win-2",
        "outputId": "HDMI-A-1",
        "frameGeometry": {
          "x": 100,
          "y": 100,
          "width": 600,
          "height": 400
        }
      }
    },
    {
      "type": "flush"
    },
    {
      "type": "screen-geometry-change",
      "outputId": "HDMI-A-1",
      "screen": {
        "outputId": "HDMI-A-1",
        "geometry": {
          "x": 0,
          "y": 0,
          "width": 2560,
          "height": 1440
        },
        "usableArea": {
          "x": 0,
          "y": 0,
          "width": 2560,
          "height": 1440
        }
      }
    },
    {
      "type": "flush"
    }
  ]
}
