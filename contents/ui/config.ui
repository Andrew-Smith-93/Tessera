     <widget class="QWidget" name="tabRules">
      <attribute name="title">
       <string>Rules &amp; Filtering</string>
      </attribute>
      <layout class="QVBoxLayout" name="rulesTabLayout">
       <property name="spacing">
        <number>10</number>
       </property>
       <item>
        <widget class="QGroupBox" name="grpGaming">
         <property name="title">
          <string>Gaming &amp; Fullscreen Policy</string>
         </property>
         <layout class="QFormLayout" name="gamingForm">
          <item row="0" column="0">
           <widget class="QLabel" name="lblGamePolicy">
            <property name="text">
             <string>Game Window Policy:</string>
