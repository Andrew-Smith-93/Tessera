     <widget class="QWidget" name="tabGeneral">
      <attribute name="title">
       <string>General</string>
      </attribute>
      <layout class="QVBoxLayout" name="generalLayout">
       <property name="spacing">
        <number>10</number>
       </property>
       <item>
        <widget class="QGroupBox" name="grpTiling">
         <property name="title">
          <string>Tiling Behavior</string>
         </property>
         <layout class="QVBoxLayout" name="tilingLayout">
          <item>
           <widget class="QCheckBox" name="kcfg_enableTiling">
            <property name="text">
             <string>Enable Tessera Window Tiling</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="kcfg_tileNewWindows">
            <property name="text">
             <string>Automatically tile newly opened windows</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="kcfg_ignoreMinimized">
            <property name="text">
             <string>Ignore minimized windows when recalculating layout</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="kcfg_perDesktopLayout">
            <property name="text">
             <string>Keep tiling arrangements separate per virtual desktop</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QCheckBox" name="kcfg_showOsd">
            <property name="text">
             <string>Show Tessera notifications for snapping and configuration changes</string>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="grpPerformance">
         <property name="title">
          <string>Performance</string>
