              </property>
             </item>
            </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="grpFloatFilter">
         <property name="title">
          <string>Floating Window Classes</string>
         </property>
         <layout class="QVBoxLayout" name="floatFilterLayout">
          <item>
           <widget class="QLabel" name="lblFloatFilterDesc">
            <property name="text">
             <string>Comma-separated list of window classes that should always float:</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLineEdit" name="kcfg_floatFilter"/>
