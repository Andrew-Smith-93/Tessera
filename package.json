{
  "name": "tessera-monorepo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "bundle:kwin": "node apps/kwin-adapter/esbuild.config.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.1"
  }
}
